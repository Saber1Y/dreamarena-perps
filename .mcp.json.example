{
  "mcpServers": {
    "dreamarena-perps": {
      "command": "node",
      "args": ["./mcp-server/dist/index.js"],
      "env": {
        "PRIVATE_KEY": "",
        "OWNER_ADDRESS": "",
        "ALLOWED_MARKETS": "BTC,ETH,SOL",
        "MAX_ORDER_USDSO": "100",
        "MAX_LEVERAGE": "5",
        "MAX_LOSS_USDSO": "100"
      }
    }
  }
}

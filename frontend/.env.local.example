# The app needs no secrets: players sign with their own wallet or with a bot
# they linked in dreamDEX, kept in their own browser.

# Optional: show an agent you run on the Agent tab (reads only; the app never
# signs with it). Never prefix these with NEXT_PUBLIC_.
# PRIVATE_KEY=
# OWNER_ADDRESS=
# ALLOWED_MARKETS=BTC,ETH,SOL
# MAX_ORDER_USDSO=100
# MAX_LEVERAGE=5
# MAX_LOSS_USDSO=100

# Optional: a different arena than contracts/deployments/50383.json.
# PERPS_ARENA=0x

# Server-only settings for the personal console. Never prefix these with
# NEXT_PUBLIC_: they would be inlined into the browser bundle.

# The bot key your Perps Arena wallet linked with dreamDEX Link a Bot. It can
# place, cancel and reduce that wallet's orders, never withdraw.
PRIVATE_KEY=

# The Perps Arena wallet the console trades.
OWNER_ADDRESS=

# Unlocks trading and runs in the browser. At least 12 characters; without
# it, the app is read-only.
CONSOLE_PASSPHRASE=

# Optional: agent limits, the same variables as the MCP server.
# ALLOWED_MARKETS=BTC,ETH,SOL
# MAX_ORDER_USDSO=100
# MAX_LEVERAGE=5
# MAX_LOSS_USDSO=100

# Optional: a different arena than contracts/deployments/50383.json.
# PERPS_ARENA=0x
